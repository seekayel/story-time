{
  "name": "story-time",
  "version": "0.1.0",
  "description": "CLI application for generating children's audio story series",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "story-time": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts --",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.28",
    "@ai-sdk/google": "^3.0.15",
    "ai": "^6.0.57",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
